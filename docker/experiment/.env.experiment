# ============================================================
# 랭킹 캐시 정합성·운영부하 실험 전용 환경변수
# (docker/experiment/docker-compose.experiment.yml 에서 사용)
#
# 변인은 한 번에 하나만 바꾼다. 한 번 측정하면 그 값으로 동결한다.
# 운영/개발 compose와 포트·네트워크·볼륨이 모두 분리돼 있어 공존 가능하다.
# ============================================================

# ---- 애플리케이션 ----
NODE_ENV=production
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_LOGIN_REDIRECT_PATH=/

# ---- 데이터베이스 (실험 전용 인스턴스) ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=funda_exp
DB_PASSWORD=funda_exp_pw
DB_NAME=funda
DB_ROOT_PASSWORD=root_exp_pw

# 핵심 실험 변인 1: DB 커넥션 풀 크기 (베이스라인=10, mysql2 기본값과 동일)
DB_POOL_SIZE=10

# ---- Redis (실험 전용 인스턴스) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- 부팅에 필요한 더미 값 (실험에서 실제 사용 안 함) ----
GITHUB_CLIENT_ID=dummy
GITHUB_CLIENT_SECRET=dummy
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
MAIL_USER=dummy
MAIL_PASS=dummy
CLOVA_STUDIO_API_KEY=dummy
CLOVA_STUDIO_URL=http://localhost
GEMINI_API_KEY=dummy
GEMINI_API_URL=http://localhost
AI_PROVIDER=gemini
SENTRY_DSN=
