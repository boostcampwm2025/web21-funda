# 랭킹 캐시 부하 측정 환경
# 비교할 때는 한 번에 한 설정만 바꾼다.

# 애플리케이션
NODE_ENV=production
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_LOGIN_REDIRECT_PATH=/

# 데이터베이스
DB_HOST=mysql
DB_PORT=3306
DB_USER=funda_exp
DB_PASSWORD=funda_exp_pw
DB_NAME=funda
DB_ROOT_PASSWORD=root_exp_pw

# mysql2 기본값과 같은 크기로 고정한다.
DB_POOL_SIZE=10

# user는 사용자별 캐시, group은 그룹 공유 캐시를 사용한다.
RANKING_CACHE_GRANULARITY=group

# 1이면 같은 그룹에서 동시에 시작된 계산을 하나로 합친다.
RANKING_SINGLE_FLIGHT=1

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# k6 요청에 사용할 토큰 서명 키
JWT_ACCESS_SECRET=experiment-access-secret
JWT_ACCESS_TTL=86400
JWT_REFRESH_SECRET=experiment-refresh-secret
JWT_REFRESH_TTL=604800

# 부팅에만 필요한 값
GITHUB_CLIENT_ID=dummy
GITHUB_CLIENT_SECRET=dummy
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
MAIL_USER=dummy
MAIL_PASS=dummy
CLOVA_STUDIO_API_KEY=dummy
CLOVA_STUDIO_URL=http://localhost
GEMINI_API_KEY=dummy
GEMINI_API_URL=http://localhost
AI_PROVIDER=gemini
SENTRY_DSN=
