# ============================================================
# 실험용 MySQL 설정 — 측정 가시성 확보
# slow query log + performance_schema 로 미스당 쿼리 비용·대기를 관측한다.
# ============================================================
[mysqld]
# --- slow query log: 느린 쿼리를 모두 기록(임계 0 = 전부) ---
slow_query_log         = 1
slow_query_log_file    = /var/lib/mysql/slow.log
long_query_time        = 0
log_queries_not_using_indexes = 1

# --- performance_schema: 쿼리/대기 계측 ---
performance_schema     = ON

# --- 커넥션 상한: 앱 풀(DB_POOL_SIZE) 포화를 관측하려면 DB가 먼저 막히면 안 된다 ---
max_connections        = 200

# --- 버퍼풀: 데이터가 메모리에 적당히 올라오도록(재현성) ---
innodb_buffer_pool_size = 512M

# --- 타임존 ---
default-time-zone      = '+09:00'
